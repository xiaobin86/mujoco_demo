<mujocoinclude>
  <asset>
    <material name="tray_blue" rgba="0.1 0.4 0.9 1"/>
  </asset>

  <worldbody>
    <!-- Target tray / platform placed on the SO101 table surface. -->
    <body name="tray" pos="0.28 0.18 0.025">
      <!-- Tray floor: 20 cm x 20 cm, 1 cm thick. -->
