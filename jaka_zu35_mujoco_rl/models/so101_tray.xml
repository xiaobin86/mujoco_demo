      <!-- Tray walls to keep the cube inside. -->
      <geom name="tray_wall_n" type="box" size="0.1 0.005 0.02" pos="0 0.105 0.02" material="tray_blue" group="2" conaffinity="3"/>
      <geom name="tray_wall_s" type="box" size="0.1 0.005 0.02" pos="0 -0.105 0.02" material="tray_blue" group="2" conaffinity="3"/>
      <geom name="tray_wall_e" type="box" size="0.005 0.1 0.02" pos="0.105 0 0.02" material="tray_blue" group="2" conaffinity="3"/>
      <geom name="tray_wall_w" type="box" size="0.005 0.1 0.02" pos="-0.105 0 0.02" material="tray_blue" group="2" conaffinity="3"/>
    </body>
  </worldbody>
</mujocoinclude>
