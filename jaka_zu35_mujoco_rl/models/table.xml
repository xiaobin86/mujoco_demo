<mujoco>
  <asset>
    <material name="table_top" rgba="0.75 0.7 0.65 1"/>
    <material name="table_leg" rgba="0.4 0.4 0.4 1"/>
  </asset>

  <worldbody>
    <!-- Table top: 1.2 m x 0.8 m, 0.02 m thick, surface at z=0. -->
    <body name="table" pos="0.5 0 -0.01">
      <geom name="table_top" type="box" size="0.6 0.4 0.01" pos="0 0 0" material="table_top" friction="0.8 0.02 0.01"/>
    </body>

    <!-- Overhead RGB camera for the simulated vision detector. -->
    <camera name="overhead_cam" mode="fixed" pos="0.5 0 1.2" xyaxes="1 0 0 0 -1 0" fovy="45"/>
  </worldbody>
</mujoco>
