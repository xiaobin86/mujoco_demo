<mujocoinclude>
  <asset>
    <material name="table_top" rgba="0.75 0.7 0.65 1"/>
  </asset>

  <worldbody>
    <!-- Table top for SO101 workspace: 1.0 m x 0.7 m, surface at z=0.02.
         Centered slightly forward so the robot base (at origin) and the cube
         region both lie on the table. -->
    <body name="table" pos="0.15 0 0.0">
      <geom name="table_top" type="box" size="0.5 0.35 0.01" pos="0 0 0.01" material="table_top" friction="1 0.2 0.05" conaffinity="3"/>
    </body>

    <!-- Overhead RGB camera looking down at the SO101 workspace. -->
    <camera name="overhead_cam" mode="fixed" pos="0.25 0 1.0" xyaxes="1 0 0 0 -1 0" fovy="45"/>
  </worldbody>
</mujocoinclude>
